# Safe default: public FPL app only.
VOLANTE_MODE=fpl_only

# Local-only bind by default.
VOLANTE_API_HOST=127.0.0.1
VOLANTE_API_PORT=8555
VOLANTE_WEB_HOST=127.0.0.1
VOLANTE_WEB_PORT=5555

# Broad browser-origin support for self-hosting / LAN use.
VOLANTE_ALLOW_ORIGIN_REGEX=^https?://[^/]+(?::\\d+)?$

# Internal mode protection.
# VOLANTE_INTEL_TOKEN=replace-me-with-a-long-random-token

# Optional background intel loop.
# VOLANTE_INTEL_MANAGER_ID=YOUR_MANAGER_ID
# VOLANTE_INTEL_HORIZON=5
# VOLANTE_INTEL_INTERVAL_MINUTES=60

# Background automation built into the API process.
VOLANTE_BACKGROUND_ENABLED=1
VOLANTE_BACKGROUND_CORE_MINUTES=60
VOLANTE_BACKGROUND_NEWS_MINUTES=15
VOLANTE_BACKGROUND_NEWS_WINDOW_HOURS=72
VOLANTE_BACKGROUND_LIVE_SECONDS=90
# Optional: comma-separated manager IDs to keep warm in the background.
# VOLANTE_BACKGROUND_MANAGER_IDS=YOUR_MANAGER_ID,ANOTHER_MANAGER_ID
VOLANTE_BACKGROUND_MANAGER_MINUTES=30
VOLANTE_BACKGROUND_MANAGER_TTL_HOURS=24
VOLANTE_BACKGROUND_PROJECTION_HORIZONS=1,5
VOLANTE_BACKGROUND_PROJECTION_DELTA=0.2

# Optional alert channels.
# VOLANTE_ALERT_STDOUT=1
# VOLANTE_ALERT_WEBHOOK=https://your-webhook-url
