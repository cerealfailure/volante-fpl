# Safe default: public FPL app only.
VOLANTE_MODE=fpl_only

# Local-only bind by default.
VOLANTE_API_HOST=127.0.0.1
VOLANTE_API_PORT=8555
VOLANTE_WEB_HOST=127.0.0.1
VOLANTE_WEB_PORT=5555

# Broad browser-origin support for self-hosting / LAN use.
VOLANTE_ALLOW_ORIGIN_REGEX=^https?://[^/]+(?::\\d+)?$

# Internal mode protection.
# VOLANTE_INTEL_TOKEN=replace-me-with-a-long-random-token

# Optional background intel loop.
# VOLANTE_INTEL_MANAGER_ID=123456
# VOLANTE_INTEL_HORIZON=5
# VOLANTE_INTEL_INTERVAL_MINUTES=60

# Optional alert channels.
# VOLANTE_ALERT_STDOUT=1
# VOLANTE_ALERT_WEBHOOK=https://your-webhook-url
