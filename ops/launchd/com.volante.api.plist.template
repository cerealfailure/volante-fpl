<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.volante.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@VOLANTE_ROOT@@/scripts/volante-api.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@@VOLANTE_ROOT@@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@@HOME@@/Library/Logs/volante-api.log</string>
  <key>StandardErrorPath</key>
  <string>@@HOME@@/Library/Logs/volante-api.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@@HOME@@</string>
    <key>VOLANTE_API_HOST</key>
    <string>0.0.0.0</string>
    <key>VOLANTE_API_PORT</key>
    <string>8555</string>
    <key>VOLANTE_ALLOW_ORIGIN_REGEX</key>
    <string>^https?://[^/]+(:[0-9]+)?$</string>
  </dict>
</dict>
</plist>
